rules_version = '2';
// 열방약국 현금정산 — Firestore 보안 규칙
// 지정한 Gmail 계정 한 개만 읽기/쓰기 가능. 그 외 모든 접근은 거부됩니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() == 'nuruk21@gmail.com';   // ← 본인 Gmail 주소
    }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function numOrNull(v) { return v == null || (v is number && v > -1000000000 && v < 1000000000); }
    function strMax(v, n) { return v is string && v.size() <= n; }

    // 일일 정산
    match /days/{d} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validDay(d, request.resource.data);
    }
    function validDay(d, x) {
      return isDate(d) && x.date == d
        && x.keys().hasOnly(['date','opening','sales','cardTerminal','moves','count','memo','closed','closedAt','updatedAt'])
        && x.closed is bool
        && numOrNull(x.get('opening', null)) && numOrNull(x.get('cardTerminal', null))
        && x.get('sales', {}) is map && x.get('count', {}) is map
        && x.get('moves', []) is list && x.get('moves', []).size() <= 100
        && strMax(x.get('memo', ''), 2000);
    }

    // 외상·요양원 거래처
    match /accounts/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['name','kind','phone','memo','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.kind in ['personal','facility']
        && strMax(request.resource.data.get('phone', ''), 40)
        && strMax(request.resource.data.get('memo', ''), 300);
    }

    // 외상 발생 / 수금 내역
    match /ledger/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validLedger(request.resource.data);
    }
    function validLedger(x) {
      return x.keys().hasOnly(['date','accountId','type','amount','method','memo','createdAt'])
        && isDate(x.date)
        && x.accountId is string
        && existsAfter(/databases/$(database)/documents/accounts/$(x.accountId))
        && x.type in ['charge','payment']
        && x.amount is number && x.amount > 0 && x.amount < 1000000000
        && (x.type == 'charge' ? x.method == null : x.method in ['cash','card','transfer'])
        && strMax(x.get('memo', ''), 500);
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
